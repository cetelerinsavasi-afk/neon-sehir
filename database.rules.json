{
  "rules": {
    ".read": false,
    ".write": false,
    "arcade": {
      "$game": {
        ".read": "auth != null",
        ".indexOn": [
          "meta/status"
        ],
        "$room": {
          ".write": "auth != null && data.child('meta/hostUid').val() === auth.uid && !newData.exists()",
          "meta": {
            ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['game', 'hostUid', 'hostName', 'status', 'createdAt']) && newData.child('game').val() === $game && newData.child('hostName').isString() && newData.child('hostName').val().length <= 40 && newData.child('status').val().matches(/^(open|playing|done)$/)"
          },
          "guest": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && data.parent().child('meta/status').val() === 'open') || data.child('uid').val() === auth.uid || data.parent().child('meta/hostUid').val() === auth.uid)",
            "uid": {
              ".validate": "newData.isString()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "left": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          },
          "state": {
            ".write": "auth != null && data.parent().child('meta/hostUid').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length < 6000"
          },
          "inH": {
            ".write": "auth != null && data.parent().child('meta/hostUid').val() === auth.uid",
            ".validate": "newData.isNumber()"
          },
          "inG": {
            ".write": "auth != null && data.parent().child('guest/uid').val() === auth.uid",
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          },
          "p": {
            "$slot": {
              ".write": "auth != null && $slot.matches(/^[1-3]$/) && ((newData.child('uid').val() === auth.uid && (!data.exists() || data.child('left').val() === true || data.child('uid').val() === auth.uid) && (data.child('uid').val() === auth.uid || data.parent().parent().child('meta/status').val() === 'open')) || data.child('uid').val() === auth.uid || data.parent().parent().child('meta/hostUid').val() === auth.uid)",
              "uid": {
                ".validate": "newData.isString() && newData.val().length <= 128"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "left": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "i": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isNumber()"
            }
          }
        }
      }
    },
    "piano": {
      "$house": {
        ".read": "auth != null",
        "player": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || now - data.child('at').val() > 30000) && (!newData.exists() || newData.child('uid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['uid', 'name', 'at']) && newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('at').isNumber() && newData.child('at').val() <= now + 5000",
          "uid": {
            ".validate": "newData.isString()"
          },
          "name": {
            ".validate": "newData.isString()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "n": {
          ".write": "auth != null && data.parent().child('player/uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['k', 't', 'uid']) && newData.child('uid').val() === auth.uid && newData.child('k').isNumber() && newData.child('k').val() >= 0 && newData.child('k').val() <= 11 && newData.child('t').isNumber() && newData.child('t').val() <= now + 5000 && (!data.exists() || newData.child('t').val() >= data.child('t').val() + 80)",
          "k": {
            ".validate": "newData.isNumber()"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "uid": {
            ".validate": "newData.isString()"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "live": {
      "$space": {
        "$room": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['t'])",
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= -5000 && newData.val() <= 5000"
            },
            "y": {
              ".validate": "newData.isNumber() && newData.val() >= -5000 && newData.val() <= 5000"
            },
            "z": {
              ".validate": "newData.isNumber() && newData.val() >= -5000 && newData.val() <= 5000"
            },
            "facing": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "pose": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "seat": {
              ".validate": "(newData.isString() && newData.val().length <= 40) || newData.isNumber()"
            },
            "left": {
              ".validate": "newData.isBoolean()"
            },
            "emote": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "emoteTs": {
              ".validate": "newData.isNumber()"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now + 1000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "streamWatch": {
      "$sid": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "streamThumb": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['img','at']) && newData.child('img').isString() && newData.child('img').val().length < 60000 && newData.child('img').val().beginsWith('data:image/jpeg') && newData.child('at').isNumber()",
        "img": {
          ".validate": true
        },
        "at": {
          ".validate": true
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "streamGame": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['g','s','at']) && newData.child('g').isString() && newData.child('g').val().length <= 20 && newData.child('s').isString() && newData.child('s').val().length < 8000 && newData.child('at').isNumber()",
        "g": {
          ".validate": true
        },
        "s": {
          ".validate": true
        },
        "at": {
          ".validate": true
        },
        "me": {
          ".validate": "newData.isNumber()"
        },
        "n": {
          ".validate": true
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
