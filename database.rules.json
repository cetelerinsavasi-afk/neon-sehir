{
  "rules": {
    ".read": false,
    ".write": false,
    "arcade": {
      "$game": {
        ".read": "auth != null",
        ".indexOn": [
          "meta/status"
        ],
        "$room": {
          ".write": "auth != null && data.child('meta/hostUid').val() === auth.uid && !newData.exists()",
          "meta": {
            ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['game', 'hostUid', 'hostName', 'status', 'createdAt']) && newData.child('game').val() === $game && newData.child('hostName').isString() && newData.child('hostName').val().length <= 40 && newData.child('status').val().matches(/^(open|playing|done)$/)"
          },
          "guest": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && data.parent().child('meta/status').val() === 'open') || data.child('uid').val() === auth.uid || data.parent().child('meta/hostUid').val() === auth.uid)",
            "uid": {
              ".validate": "newData.isString()"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "left": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          },
          "state": {
            ".write": "auth != null && data.parent().child('meta/hostUid').val() === auth.uid",
            ".validate": "newData.isString() && newData.val().length < 6000"
          },
          "inH": {
            ".write": "auth != null && data.parent().child('meta/hostUid').val() === auth.uid",
            ".validate": "newData.isNumber()"
          },
          "inG": {
            ".write": "auth != null && data.parent().child('guest/uid').val() === auth.uid",
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          },
          "p": {
            "$slot": {
              ".write": "auth != null && $slot.matches(/^[1-3]$/) && ((newData.child('uid').val() === auth.uid && (!data.exists() || data.child('left').val() === true || data.child('uid').val() === auth.uid) && (data.child('uid').val() === auth.uid || data.parent().parent().child('meta/status').val() === 'open')) || data.child('uid').val() === auth.uid || data.parent().parent().child('meta/hostUid').val() === auth.uid)",
              "uid": {
                ".validate": "newData.isString() && newData.val().length <= 128"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "left": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "i": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isNumber()"
            }
          },
          "rtc": {
            "$uid": {
              ".write": "auth != null && $uid.matches(/^[A-Za-z0-9_-]{1,128}$/) && (auth.uid === $uid || data.parent().parent().child('meta/hostUid').val() === auth.uid)",
              "o": {
                ".validate": "newData.isString() && newData.val().length < 12000"
              },
              "a": {
                ".validate": "newData.isString() && newData.val().length < 12000"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    },
    "piano": {
      "$house": {
        ".read": "auth != null",
        "player": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || now - data.child('at').val() > 30000) && (!newData.exists() || newData.child('uid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['uid', 'name', 'at']) && newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('at').isNumber() && newData.child('at').val() <= now + 5000",
          "uid": {
            ".validate": "newData.isString()"
          },
          "name": {
            ".validate": "newData.isString()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "n": {
          ".write": "auth != null && data.parent().child('player/uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['k', 't', 'uid']) && newData.child('uid').val() === auth.uid && newData.child('k').isNumber() && newData.child('k').val() >= 0 && newData.child('k').val() <= 11 && newData.child('t').isNumber() && newData.child('t').val() <= now + 5000 && (!data.exists() || newData.child('t').val() >= data.child('t').val() + 80)",
          "k": {
            ".validate": "newData.isNumber()"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "uid": {
            ".validate": "newData.isString()"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "live": {
      "$space": {
        "$room": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['t'])",
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= -5000 && newData.val() <= 5000"
            },
            "y": {
              ".validate": "newData.isNumber() && newData.val() >= -5000 && newData.val() <= 5000"
            },
            "z": {
              ".validate": "newData.isNumber() && newData.val() >= -5000 && newData.val() <= 5000"
            },
            "facing": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "pose": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "seat": {
              ".validate": "(newData.isString() && newData.val().length <= 40) || newData.isNumber()"
            },
            "left": {
              ".validate": "newData.isBoolean()"
            },
            "emote": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "emoteTs": {
              ".validate": "newData.isNumber()"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now + 1000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "streamWatch": {
      "$sid": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "streamThumb": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['img','at']) && newData.child('img').isString() && newData.child('img').val().length < 60000 && newData.child('img').val().beginsWith('data:image/jpeg') && newData.child('at').isNumber()",
        "img": {
          ".validate": true
        },
        "at": {
          ".validate": true
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "streamGame": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['g','s','at']) && newData.child('g').isString() && newData.child('g').val().length <= 20 && newData.child('s').isString() && newData.child('s').val().length < 8000 && newData.child('at').isNumber()",
        "g": {
          ".validate": true
        },
        "s": {
          ".validate": true
        },
        "at": {
          ".validate": true
        },
        "me": {
          ".validate": "newData.isNumber()"
        },
        "n": {
          ".validate": true
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "occ": {
      ".read": "auth != null",
      "$place": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $place.matches(/^(park|i~[A-Za-z0-9_-]{1,60}|h~[A-Za-z0-9_-]{1,120})$/)",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        }
      }
    },
    "city": {
      "p": {
        "$cell": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $cell.matches(/^[0-9]{1,2}_[0-9]{1,2}$/)",
            ".validate": "newData.hasChildren(['x','z','t'])",
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= -400 && newData.val() <= 400"
            },
            "z": {
              ".validate": "newData.isNumber() && newData.val() >= -400 && newData.val() <= 400"
            },
            "l": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            },
            "m": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            },
            "r": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            },
            "p": {
              ".validate": "newData.isString() && newData.val().matches(/^[wsdr]$/)"
            },
            "sy": {
              ".validate": "newData.isNumber() && newData.val() >= -5 && newData.val() <= 10"
            },
            "e": {
              ".validate": "newData.isString() && newData.val().length <= 12"
            },
            "et": {
              ".validate": "newData.isNumber()"
            },
            "h": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "ro": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "rk": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now + 1000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "c": {
        "$cell": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $cell.matches(/^[0-9]{1,2}_[0-9]{1,2}$/)",
            ".validate": "newData.hasChildren(['v','x','z','y','t'])",
            "v": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 30"
            },
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= -400 && newData.val() <= 400"
            },
            "z": {
              ".validate": "newData.isNumber() && newData.val() >= -400 && newData.val() <= 400"
            },
            "y": {
              ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 1000"
            },
            "s": {
              ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 100"
            },
            "st": {
              ".validate": "newData.isNumber() && newData.val() >= -2 && newData.val() <= 2"
            },
            "d": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now + 1000"
            },
            "ct": {
              ".validate": "newData.isNumber() && newData.val() <= now + 10000 && newData.val() >= now - 60000"
            },
            "m": {
              ".validate": "newData.isString() && newData.val().length <= 700"
            },
            "j": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 40"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "m": {
        "$cell": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $cell.matches(/^[0-9]{1,2}_[0-9]{1,2}$/) && (!newData.exists() || !root.child('mutes').child($uid).exists() || root.child('mutes').child($uid).val() < now)",
            ".validate": "newData.hasChildren(['x','t']) && (!data.exists() || newData.child('t').val() >= data.child('t').val() + 1200)",
            "x": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now + 1000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "u": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n','a','t'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "a": {
            ".validate": "newData.isString() && newData.val().length <= 8000"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now + 1000"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "s": {
        "$owner": {
          ".read": "auth != null",
          "$k": {
            ".write": "auth != null && $k.matches(/^([1-9]|[12][0-9])$/) && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()) || (auth.uid === $owner && !newData.exists()))",
            ".validate": "newData.isString()"
          },
          ".write": "auth != null && auth.uid === $owner && !newData.exists()"
        }
      }
    },
    "mutes": {
      ".read": false,
      ".write": false
    }
  }
}