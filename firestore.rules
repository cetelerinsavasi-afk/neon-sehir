rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------------
    // users/{uid} — oyuncu profili.
    // Tüm kritik alanlar (gold, suspicion, profession vb.) sadece Cloud
    // Functions (Admin SDK) tarafından yazılabilir; Admin SDK bu kuralları
    // zaten bypass eder. İstemcinin doğrudan yazması burada tamamen
    // engellenmiştir (Bölüm 15).
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;

      // isPolice — Bölüm 14 gereği sadece doküman sahibi okuyabilir.
      // Cloud Functions (soygun/heist mantığı, Faz 5) Admin SDK ile
      // bu kısıtlamayı bypass ederek okuyabilir.
      match /private/{docId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /productionMachines/{machineId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /inventory/{itemId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // messages/{msgId} — SMS gelen kutusu (soygun sızma uyarısı vb.).
      match /messages/{msgId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      // sixtagramNotifications/{notifId} — "beğenildim/yorum aldım/
      // yanıt aldım" bildirimleri. Sadece sahibi okuyabilir.
      match /sixtagramNotifications/{notifId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // ---------------------------------------------------------------------
    // dailyActions/{uid}_{YYYY-MM-DD} — günlük hak takibi.
    // Sadece kendi dokümanını okuyabilir; ID formatı "{uid}_..." olduğu
    // için split ile kontrol ediyoruz.
    // ---------------------------------------------------------------------
    match /dailyActions/{docId} {
      allow read: if isSignedIn() && docId.split('_')[0] == request.auth.uid;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // Herkese açık, salt-okunur veriler (Cloud Functions tarafından yazılır)
    // ---------------------------------------------------------------------
    match /investments/{date} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // investmentHistory/{docId} — saatlik fiyat geçmişi (çizgi grafik için).
    match /investmentHistory/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // onNumaraTables/{tableId} — "10 Numara" kart oyunu masaları.
    match /onNumaraTables/{tableId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // mosqueAttendance/{dateKey}/members/{uid} — "Bugünkü Cemaat" listesi.
    match /mosqueAttendance/{dateKey}/members/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // beggars/{dateKey}/entries/{uid} — günlük dilenci listesi.
    match /beggars/{dateKey}/entries/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // imamState/current — oyundaki tek imamın bilgisi (herkes görebilir).
    // imamState/meta — son azledilen imam uid'si (sadece Cloud Functions okur/yazar).
    match /imamState/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // factories/{ownerId} — oyuncu fabrikaları. Herkes görebilir (fabrika
    // listesi/rekabet için), yazma sadece Cloud Functions ile.
    match /factories/{ownerId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /machines/{machineId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    match /shipSchedule/{date} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // policeClaimPool/{dateKey} — polis maaş havuzu (bugünkü toplam tutar,
    // polis başı pay). Herkes görebilmeli (Karakol ekranında gösteriliyor);
    // yazma sadece Cloud Functions (dailyReset/claimPoliceSalary) ile.
    match /policeClaimPool/{dateKey} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // gameStats/{docId} — genel oyun istatistikleri (ör. polis kitapçığındaki
    // ortalama günlük kazanç). Herkes okuyabilir, sadece Cloud Functions yazar.
    match /gameStats/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // limanOrders/{uid} — oyuncunun mevcut turdaki bekleyen Liman siparişi.
    // Sadece kendi siparişini görebilir; yazma sadece Cloud Functions ile.
    match /limanOrders/{orderUid} {
      allow read: if isSignedIn() && orderUid == request.auth.uid;
      allow write: if false;
    }

    // heistPlans/{planId} — ekip soygun planları. Herkes görüp katılabilmeli,
    // bu yüzden herkese açık okunur; yazma sadece Cloud Functions ile.
    match /heistPlans/{planId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /participants/{participantUid} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // raceRooms/{roomId} — yarış pisti odaları. Herkes açık odaları görüp
    // katılabilmeli; yazma sadece Cloud Functions ile.
    match /raceRooms/{roomId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // trainingProgress/{uid} — antrenman modunda açılan seviyeler/ödül
    // alınan seviyeler. Sadece sahibi okuyabilir.
    match /trainingProgress/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // championshipDaily/{catalogId}_{dateKey} — araç başına günlük şampiyona
    // lideri/kazananı. Herkes görebilmeli (Şampiyona ekranında gösteriliyor);
    // yazma sadece Cloud Functions (championshipRollDice/dailyReset) ile.
    match /championshipDaily/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // lottery/{dateKey} — piyango. Herkes güncel jackpot'u ve geçmiş
    // kazananları görebilmeli; yazma sadece Cloud Functions ile.
    match /lottery/{dateKey} {
      allow read: if isSignedIn();
      allow write: if false;

      match /tickets/{ticketUid} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // marketplaceListings/{listingId} — 2. el satış ilanları (Bölüm 9.1).
    // Herkes ilanları görüp satın alabilmeli; yazma sadece Cloud Functions.
    match /marketplaceListings/{listingId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // globalChat/{msgId} — ChatsApp, tüm oyunculara açık genel sohbet.
    match /globalChat/{msgId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // parkPresence/{uid} — Park dünyasındaki canlı konum/pose/elde-tutulan
    // ürün/sohbet balonu. İSTİSNAİ OLARAK doğrudan istemci yazımına izin
    // verilir (her hareket karesinde Cloud Function çağırmak pratik değil
    // — bkz. functions/index.js enterPark üstündeki not) ama SADECE:
    //   1) kendi dokümanına (isSelf),
    //   2) izin verilen, ekonomiyle ilgisiz alanlara,
    //   3) avatar/displayName'i DEĞİŞTİRMEDEN — bu iki alan enjeksiyon
    //      riski taşıdığı için (istemci tarafında dangerouslySetInnerHTML
    //      ile ham SVG'ye gömülüyor) sadece enterPark Cloud Function'ı,
    //      users/{uid} içindeki ZATEN doğrulanmış veriyi kopyalayarak
    //      yazabilir; sıradan hareket güncellemeleri bu iki alana
    //      dokunamaz (create sırasında enterPark'ın yazdığı değerle aynı
    //      kalmak zorunda).
    function validParkPresenceFields() {
      let d = request.resource.data;
      return d.keys().hasOnly([
        'displayName', 'avatar', 'x', 'y', 'facing', 'pose', 'holding', 'seat',
        'chatText', 'chatTs', 'updatedAt', 'enteredAt'
      ])
        && d.x is number && d.x >= 0 && d.x <= 2000
        && d.y is number && d.y >= 0 && d.y <= 2000
        && (d.chatText == null || (d.chatText is string && d.chatText.size() <= 140));
    }
    match /parkPresence/{uid} {
      allow read: if isSignedIn();
      // İlk giriş sadece enterPark (Admin SDK) tarafından yapılır; Admin
      // SDK bu kuralları zaten bypass eder, o yüzden create burada
      // istemciye kapalı.
      allow create: if false;
      allow update: if isSelf(uid)
        && validParkPresenceFields()
        && request.resource.data.avatar == resource.data.avatar
        && request.resource.data.displayName == resource.data.displayName;
      // Park'tan çıkarken kendi konum kaydını silebilir (terk edilenler
      // ayrıca expireParkPresence ile arka planda süpürülür).
      allow delete: if isSelf(uid);
    }

    // interiorPresence/{uid} — Banka/Karakol/Camii/Gazino'daki canlı konum
    // (madde 17). parkPresence ile BİREBİR aynı güven modeli — tek fark,
    // dört mekanın hepsi `locationId` alanıyla ayrılan TEK bir koleksiyonu
    // paylaşıyor (bkz. functions/index.js enterInterior).
    function validInteriorPresenceFields() {
      let d = request.resource.data;
      return d.keys().hasOnly([
        'locationId', 'displayName', 'avatar', 'x', 'y', 'facing', 'pose', 'holding', 'seat',
        'chatText', 'chatTs', 'updatedAt', 'enteredAt'
      ])
        && d.locationId in ['banka', 'karakol', 'camii', 'gazino', 'araba_galerisi', 'silah_magazasi', 'modifiye_garaji']
        && d.x is number && d.x >= 0 && d.x <= 2000
        && d.y is number && d.y >= 0 && d.y <= 2000
        && (d.chatText == null || (d.chatText is string && d.chatText.size() <= 140));
    }
    match /interiorPresence/{uid} {
      allow read: if isSignedIn();
      // İlk giriş sadece enterInterior (Admin SDK) tarafından yapılır.
      allow create: if false;
      allow update: if isSelf(uid)
        && validInteriorPresenceFields()
        && request.resource.data.avatar == resource.data.avatar
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.locationId == resource.data.locationId;
      // Mekandan çıkarken kendi konum kaydını silebilir (terk edilenler
      // ayrıca expireInteriorPresence ile arka planda süpürülür).
      allow delete: if isSelf(uid);
    }

    // usernames/{lowercaseName} — benzersiz oyun içi isim rezervasyonu.
    // Sadece varlık kontrolü için okunabilir; yazma Cloud Functions ile.
    match /usernames/{name} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /weapons/{weaponId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- Futbol modülü (Faz 2) ---
    // Ligler/takımlar/oyuncular/maçlar herkese açık okunur (lig tablosu,
    // fikstür vb. herkes görebilmeli); tüm yazmalar Cloud Functions ile.
    match /futbolLeagues/{leagueId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /futbolTeams/{teamId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /futbolPlayers/{playerId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /futbolMatches/{matchId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // futbolBets/{betId} — iddaa kuponları. Herkes başkasının kuponunu
    // göremez, sadece kendi kuponların. Yazma sadece Cloud Functions ile.
    match /futbolBets/{betId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // futbolGrowthLogs/{logId} — "Gelişimler" günlüğü (maç/antrenmanda
    // güç kazanan oyuncular). Takımlar herkese açık göründüğü için bu da
    // aynı şekilde herkese açık okunur; yazma sadece Cloud Functions ile.
    match /futbolGrowthLogs/{logId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // newsEvents/{eventId} — Faz Gazete: gün içinde olan (soygun/
    // tutuklama/futbol/sezon sonu) olayların anonimleştirilmiş özeti.
    // Herkes okuyabilir; yazma sadece Cloud Functions ile.
    match /newsEvents/{eventId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // flappyScores/{uid} — telefondaki Flappy Bird mini oyununun kişisel
    // en iyi skoru. Herkes okuyabilmeli (genel "en iyi 10" tablosu için);
    // yazma sadece Cloud Functions (submitFlappyScore) ile.
    match /flappyScores/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // newspaperBulletin/current — Gazete > Borsa Bülteni için gece
    // 00:00'da dondurulan fiyat anlık görüntüsü. Herkes okuyabilir;
    // yazma sadece Cloud Functions (dailyReset) ile.
    match /newspaperBulletin/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // sixtagramPosts/{postId} — mini sosyal medya postları. Herkes
    // okuyabilir (akış herkese açık); yazma sadece Cloud Functions ile
    // (createSixtagramPost/toggleSixtagramLike/deleteSixtagramPost/
    // cleanupSixtagramPosts).
    match /sixtagramPosts/{postId} {
      allow read: if isSignedIn();
      allow write: if false;

      // likes/{uid} — kimin beğendiğini istemcinin "beğenildi mi?"
      // durumunu göstermesi için okunabilir; yazma yine sadece Cloud
      // Functions ile (toggleSixtagramLike).
      match /likes/{uid} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      // comments/{commentId} — herkes okuyabilir (yorumlar da postlar
      // gibi herkese açık); yazma sadece Cloud Functions ile
      // (createSixtagramComment).
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // sixtagramProfiles/{uid} — HERKESE AÇIK profil özeti (isim/avatar/
    // toplam beğeni). users/{uid} sadece sahibi tarafından okunabildiği
    // için, başka bir oyuncunun postuna tıklayınca açılan profil paneli
    // buradan okur. Yazma sadece Cloud Functions ile.
    match /sixtagramProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // sixtagramUserLikes/{uid} — "hangi postları beğendim" haritası.
    // SADECE sahibi okuyabilir (başkasının beğeni geçmişini görmesin);
    // yazma sadece Cloud Functions ile (toggleSixtagramLike).
    match /sixtagramUserLikes/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // redemptionCodes/{code} — "Altın Mağazası" teslimat kodu → uid
    // eşlemesi. Sadece Cloud Functions (getMyRedemptionCode/
    // shopierOsbWebhook) okur/yazar; istemciye tamamen kapalı (kodun
    // kendisini zaten users/{uid}.redemptionCode üzerinden okuyorsun).
    match /redemptionCodes/{code} {
      allow read, write: if false;
    }

    // shopierOrders/{orderId} — başarıyla altın basılmış Shopier
    // siparişleri (idempotentlik + kayıt amaçlı). İstemciye kapalı.
    match /shopierOrders/{orderId} {
      allow read, write: if false;
    }

    // shopierUnmatchedOrders/{orderId} — ödeme alınmış ama teslimat kodu
    // eşleşmediği için altın basılamamış siparişler. Sadece geliştirici
    // (Firebase Console) görsün diye istemciye tamamen kapalı.
    match /shopierUnmatchedOrders/{orderId} {
      allow read, write: if false;
    }

    // Tanımlanmamış her şey varsayılan olarak kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
