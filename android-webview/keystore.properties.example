# Bu dosyanın KOPYASINI "keystore.properties" adıyla aynı klasöre kaydet ve
# şifreleri yaz. keystore.properties git'e EKLENMEZ (.gitignore).
#
# storeFile: android-webview/ klasörüne göre yol. Eski TWA'nın keystore'u
# (paket imzası aynı kalmalı — değiştirme!):
storeFile=../android/android.keystore
storePassword=KEYSTORE_SIFRESI
keyAlias=android
keyPassword=ANAHTAR_SIFRESI
