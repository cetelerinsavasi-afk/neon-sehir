<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ana tema: her yer #070A12 — sayfa yüklenirken beyaz flaş olmaz -->
    <style name="Theme.NeonSehir" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/neon_bg</item>
        <item name="android:colorBackground">@color/neon_bg</item>
        <item name="android:statusBarColor">@color/neon_bg</item>
        <item name="android:navigationBarColor">@color/neon_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Açılış ekranı (androidx.core:core-splashscreen) -->
    <style name="Theme.NeonSehir.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/neon_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_maskable</item>
        <item name="postSplashScreenTheme">@style/Theme.NeonSehir</item>
    </style>
</resources>
